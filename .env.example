# PatchPilot runs entirely on local hardware. There are no API keys.
#
# Provider options:
#   ollama        Ollama's native API (default)
#   local-openai  Any OpenAI-compatible local server — LM Studio (including
#                 the Bionic app), llama.cpp, vLLM
PATCHPILOT_PROVIDER=ollama
PATCHPILOT_MODEL=qwen2.5-coder:7b

# Ollama endpoint. Localhost counts as local compute; a LAN or Tailscale
# address is treated as remote compute. Workspace tools always run locally.
PATCHPILOT_OLLAMA_URL=http://127.0.0.1:11434
PATCHPILOT_KEEP_ALIVE=15m
PATCHPILOT_NUM_CTX=8192

# OpenAI-compatible local server. LM Studio serves this at :1234 by default.
# The key is only needed by servers configured to require one.
PATCHPILOT_LOCAL_URL=http://127.0.0.1:1234/v1
# PATCHPILOT_LOCAL_API_KEY=

# Runtime tuning.
PATCHPILOT_NUM_PREDICT=8192
PATCHPILOT_TEMPERATURE=0.1

# Thinking is a model capability: auto leaves it to the model, on/off force it
# where the model supports it at all.
PATCHPILOT_THINKING=auto
PATCHPILOT_STEP_BUDGET=adaptive
PATCHPILOT_SUBAGENTS=off
