{
  "name": "@jx-grxf/patchpilot",
  "version": "1.2.2",
  "private": false,
  "description": "Local-only coding agent TUI: a harness that makes local models reliable.",
  "type": "module",
  "bin": {
    "patchpilot": "dist/cli.js"
  },
  "files": [
    "dist",
    ".env.example",
    "docs/architecture.md",
    "docs/product-context.md",
    "docs/releases",
    "docs/showcase/patchpilot-banner.png",
    "docs/showcase/patchpilot-logo.png",
    "docs/showcase/patchpilot-showcase.svg",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jx-grxf/PatchPilot.git"
  },
  "bugs": {
    "url": "https://github.com/jx-grxf/PatchPilot/issues"
  },
  "homepage": "https://johannesgrof.me/projects/patchpilot/",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/cli.tsx",
    "build": "npm run clean && tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm audit --omit=dev --audit-level=moderate && npm pack --dry-run",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ollama",
    "lm-studio",
    "llama-cpp",
    "local-llm",
    "agent",
    "tui",
    "coding-agent",
    "local-ai"
  ],
  "author": "Johannes Grof",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "ink": "7.0.5",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.6",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=22"
  }
}
